改名命令

#细菌改名
for f in *.fastq; do
    new=$(echo "$f" | sed -E 's/^([A-Z]{1,3}[0-9])_([0-9])\.799F_1193R\.R([12])\.raw\.fastq$/\1\2_16S_R\3.fastq/')
    [ "$f" != "$new" ] && mv "$f" "$new"
done




